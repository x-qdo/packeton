{% extends "layout.html.twig" %}

{% block content %}
<h2 class="title">Webhook Secret Created</h2>

<div class="alert alert-warning">
    <strong>Important:</strong> This is the only time the secret will be shown. Copy it now and store it securely.
</div>

<div class="panel panel-success">
    <div class="panel-heading">
        <h3 class="panel-title">{{ secret.name }}</h3>
    </div>
    <div class="panel-body">
        <div class="form-group">
            <label>Secret</label>
            <div class="input-group">
                <input type="text" class="form-control" id="secret-value" value="{{ generatedSecret }}" readonly>
                <span class="input-group-btn">
                    <button class="btn btn-default" type="button" onclick="copySecret()">
                        Copy
                    </button>
                </span>
            </div>
        </div>
    </div>
</div>

<h3>GitHub Webhook Configuration</h3>
<p>Use these settings when configuring your GitHub webhook:</p>
<table class="table table-bordered">
    <tr>
        <th>Payload URL</th>
        <td><code>{{ app.request.schemeAndHttpHost }}/api/hooks/github</code></td>
    </tr>
    <tr>
        <th>Content type</th>
        <td><code>application/json</code></td>
    </tr>
    <tr>
        <th>Secret</th>
        <td><code id="secret-display">{{ generatedSecret }}</code></td>
    </tr>
</table>

<a href="{{ path('webhook_secret_index') }}" class="btn btn-primary">Back to Secrets List</a>

<script>
function copySecret() {
    var input = document.getElementById('secret-value');
    input.select();
    input.setSelectionRange(0, 99999);
    document.execCommand('copy');
    alert('Secret copied to clipboard!');
}
</script>
{% endblock %}
