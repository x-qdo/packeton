{% extends "layout.html.twig" %}

{% block content %}
<h2 class="title">Create Webhook Secret</h2>

{% for message in app.flashes('error') %}
    <div class="alert alert-danger">{{ message }}</div>
{% endfor %}

<form method="post" action="{{ path('webhook_secret_create') }}">
    <div class="form-group">
        <label for="name">Name</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="e.g., GitHub Org Webhook" required>
        <p class="help-block">A descriptive name to identify this secret</p>
    </div>

    <div class="alert alert-info">
        <strong>Note:</strong> The secret will be auto-generated and shown only once after creation. Make sure to copy it immediately.
    </div>

    <button type="submit" class="btn btn-primary">Create Secret</button>
    <a href="{{ path('webhook_secret_index') }}" class="btn btn-default">Cancel</a>
</form>
{% endblock %}
